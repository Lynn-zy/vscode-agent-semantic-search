{
  "name": "vscode-agent-semantic-search",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.4",
  "publisher": "Lynn-zy",
  "author": "Lynn-zy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lynn-zy/vscode-agent-semantic-search.git"
  },
  "homepage": "https://github.com/Lynn-zy/vscode-agent-semantic-search#readme",
  "bugs": {
    "url": "https://github.com/Lynn-zy/vscode-agent-semantic-search/issues"
  },
  "icon": "assets/icon.png",
  "extensionDependencies": [
    "github.copilot-chat"
  ],
  "keywords": [
    "semantic-search",
    "code-search",
    "copilot",
    "agent",
    "llm-tools",
    "ai"
  ],
  "qna": "marketplace",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelTool:semanticSearch"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelTools": [
      {
        "name": "semanticSearch",
        "toolReferenceName": "semanticSearch",
        "displayName": "%tools.semanticSearch.displayName%",
        "icon": "assets/icon.svg",
        "modelDescription": "%tools.semanticSearch.modelDescription%",
        "userDescription": "%tools.semanticSearch.userDescription%",
        "canBeReferencedInPrompt": true,
        "tags": [
          "codesearch"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "%tools.semanticSearch.query.description%"
            },
            "scopedDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "%tools.semanticSearch.scopedDirectories.description%"
            }
          },
          "required": [
            "query"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "semanticSearch.buildIndex",
        "title": "%commands.buildIndex.title%",
        "category": "%commands.category%"
      },
      {
        "command": "semanticSearch.collectIndexDiagnostics",
        "title": "%commands.collectDiagnostics.title%",
        "category": "%commands.category%"
      },
      {
        "command": "semanticSearch.showMenu",
        "title": "%commands.showMenu.title%",
        "category": "%commands.category%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "semanticSearch.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.enabled.description%"
        },
        "semanticSearch.timeoutMs": {
          "type": "number",
          "default": 45000,
          "minimum": 5000,
          "maximum": 180000,
          "description": "%config.timeoutMs.description%"
        },
        "semanticSearch.showDegradationHints": {
          "type": "boolean",
          "default": true,
          "description": "%config.showDegradationHints.description%"
        },
        "semanticSearch.appendCodeUsagesHint": {
          "type": "boolean",
          "default": true,
          "description": "%config.appendCodeUsagesHint.description%"
        },
        "semanticSearch.relayToolId": {
          "type": "string",
          "default": "copilot_searchCodebase",
          "description": "%config.relayToolId.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "prettier": "^3.9.8",
    "typescript": "^5.4.5"
  }
}
